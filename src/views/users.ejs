<%- include('includes/header') %>

  <link rel="stylesheet" type="text/css" href="/css/users.css" />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Poppins:wght@300;500&display=swap"
    rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.js"></script>

  <body>
    <div class="users-page-wrapper">
      <!-- Fon bloblari -->
      <div class="blob-c">
        <div class="shape-blob one"></div>
        <div class="shape-blob two"></div>
      </div>

      <!-- Navigatsiya Menyu -->
      <div class="navigation-menu glass-nav">
        <ul class="nav justify-content-center">
          <li class="nav-item"><a class="nav-link" href="/admin/">Home</a></li>
          <% if(!user) { %>
            <li class="nav-item"><a class="nav-link" href="/admin/signup">SignUp</a></li>
            <li class="nav-item"><a class="nav-link login-btn" href="/admin/login">Login</a></li>
            <% } else { %>
              <li class="nav-item"><a class="nav-link" href="/admin/product/all">Menu</a></li>
              <li class="nav-item"><a class="nav-link active" href="/admin/user/all">Users</a></li>
              <!-- Navbarda User yozuvi -->
              <li class="nav-item user-info-nav">
                <span class="nav-user-name"><i class="fas fa-user-circle"></i>
                  <%= user.userNick %>
                </span>
              </li>
              <li class="nav-item logout-item" onclick="return confirm('Tizimdan chiqmoqchimisiz?')">
                <a class="nav-link" href="/admin/logout">Logout</a>
              </li>
              <% } %>
        </ul>
      </div>

      <div class="users-main-content">
        <!-- 3D Animatsiya sferasi (Chap tomonda yoki fonda) -->
        <div class="scene-3d">
          <div class="sphere-wrapper">
            <svg class="sphere-svg" viewBox="0 0 440 440">
              <defs>
                <linearGradient id="userGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#a855f7" />
                  <stop offset="100%" stop-color="#3b82f6" />
                </linearGradient>
              </defs>
              <g class="paths-group">
                <!-- SIZNING BARCHA PATHLARINGIZ SHU YERDA -->
                <path
                  d="M361.604 361.238c-24.407 24.408-51.119 37.27-59.662 28.727-8.542-8.543 4.319-35.255 28.726-59.663 24.408-24.407 51.12-37.269 59.663-28.726 8.542 8.543-4.319 35.255-28.727 59.662z" />
                <!-- ... barcha pathlarni kiritganingizga ishonch hosil qiling ... -->
              </g>
            </svg>
          </div>
        </div>

        <!-- Jadval qismi (Glass Card) -->
        <div class="users-frame">
          <% if(!user) { %>
            <div class="glass-card error-board">
              <h2>Iltimos, avval tizimga kiring!</h2>
              <a href="/admin/login" class="neon-btn">Login</a>
            </div>
            <% } else { %>
              <div class="glass-card board">
                <div class="user-table-container">
                  <span class="header-name">All Users</span>
                  <table class="table cyber-table">
                    <thead>
                      <tr>
                        <th>T/r</th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Status</th>
                      </tr>
                    </thead>
                    <tbody>
                      <!-- Bu yerda loop bo'ladi, hozircha misol: -->
                      <% users.map((value, index)=> { %>
                    <tbody style="background: #151728">
                      <td>
                        <%= index + 1 %>
                      </td>
                      <td>
                        <%= value.userNick %>
                      </td>
                      <td>
                        <%= value.userPhone %>
                      </td>
                      <td style="width: 13%">
                        <select class="spec-select user-status" id="<%= value._id %>">
                          <option value="ACTIVE" <%=value.userStatus==="ACTIVE" ? "selected" : "" %>>ACTIVE</option>
                          <option value="BLOCK" <%=value.userStatus==="BLOCK" ? "selected" : "" %>>BLOCK</option>
                          <option value="DELETE" <%=value.userStatus==="DELETE" ? "selected" : "" %>>DELETE</option>
                        </select>
                      </td>
                    </tbody>
                    <% }) %>
                      </tbody>
                  </table>
                </div>
              </div>
              <% } %>
        </div>
      </div>
    </div>

    <script type="text/javascript" src="/js/users.js"></script>
  </body>
  <%- include('includes/footer') %>