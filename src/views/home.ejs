<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/home.css" />
<!-- Ikonkalar va Fontlar -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
<!-- Animatsiya kutubxonasi -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.js"></script>

<body>
  <div class="home-container">
    <!-- Fondagi neon animatsiyalar -->
    <div class="blob-c">
      <div class="shape-blob one"></div>
      <div class="shape-blob two"></div>
    </div>

    <!-- Glassmorphism Navigatsiya -->
    <div class="navigation-menu">
      <ul class="nav justify-content-center align-items-center">
        <li class="nav-item"><a class="nav-link active" href="/admin">Home</a></li>

        <% if(!user) { %>
          <li class="nav-item"><a class="nav-link" href="/admin/signup">SignUp</a></li>
          <li class="nav-item"><a class="nav-link login-btn" href="/admin/login">Login</a></li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/admin/product/all">Menu</a></li>
          <li class="nav-item"><a class="nav-link" href="/admin/user/all">Users</a></li>

          <!-- User Badge -->
          <li class="nav-item user-badge">
            <span class="nav-user-name">
              <i class="fas fa-user-shield"></i>
              <%= user.userNick %>
            </span>
          </li>

          <li class="nav-item logout-item" onclick="return confirm('Tizimdan chiqmoqchimisiz?')">
            <a class="nav-link" href="/admin/logout">Logout</a>
          </li>
        <% } %>
      </ul>
    </div>

    <!-- Hero Section -->
    <div class="hero-section">
      <div class="animation-frame">
        <div class="animation-wrapper">
          <div class="sphere-animation">
            <svg class="sphere" viewBox="0 0 440 440">
              <defs>
                <linearGradient id="sphereGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop stop-color="#00f2fe" offset="0%" />
                  <stop stop-color="#4facfe" offset="100%" />
                </linearGradient>
              </defs>
              <!-- Sfera chiziqlari -->
              <path d="M361.604 361.238c-24.407 24.408-51.119 37.27-59.662 28.727-8.542-8.543 4.319-35.255 28.726-59.663 24.408-24.407 51.12-37.269 59.663-28.726 8.542 8.543-4.319 35.255-28.727 59.662z" />
              <path d="M109.698 109.332c-24.408 24.407-51.12 37.268-59.663 28.726-8.542-8.543 4.319-35.255 28.727-59.662 24.407-24.408 51.12-37.27 59.662-28.727 8.543 8.543-4.319 35.255-28.726 59.663z" />
              <path d="M220 440c121.503 0 220-98.497 220-220S341.503 0 220 0 0 98.497 0 220s98.497 220 220 220z" />
            </svg>
          </div>
        </div>
      </div>
        <h1 style="margin-top: 70px;">Welcome!</h1>
    </div>
  </div>

  <script type="text/javascript" src="/js/home.js"></script>
</body>
<%- include('includes/footer') %>