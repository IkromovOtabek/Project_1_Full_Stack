<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/products.css" />
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Poppins:wght@300;500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<body>
  <div class="products-page-wrapper">
    <div class="blob-c">
      <div class="shape-blob one"></div>
      <div class="shape-blob two"></div>
    </div>

    <div class="navigation-menu glass-nav">
      <ul class="nav justify-content-center">
        <li class="nav-item"><a class="nav-link" href="/admin/">Home</a></li>
        <li class="nav-item"><a class="nav-link active" href="/admin/product/all">Menu</a></li>
        <li class="nav-item"><a class="nav-link" href="/admin/user/all">Users</a></li>
        <% if(user) { %>
          <li class="nav-item user-info-nav">
            <span class="nav-user-name"><i class="fas fa-user-circle"></i> <%= user.userNick %></span>
          </li>
        <% } %>
        <li class="nav-item logout-item" onclick="return confirm('Tizimdan chiqmoqchimisiz?')">
          <a class="nav-link" href="/admin/logout">Logout</a>
        </li>
      </ul>
    </div>

    <div class="main-content-3d">
      <div class="scene-3d">
        <div class="sphere-wrapper">
          <svg class="sphere-svg" viewBox="0 0 440 440">
            <defs>
              <linearGradient id="prodGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#a855f7" /><stop offset="100%" stop-color="#3b82f6" />
              </linearGradient>
            </defs>
            <g class="paths-group">
              <path d="M361.604 361.238c-24.407 24.408-51.119 37.27-59.662 28.727-8.542-8.543 4.319-35.255 28.726-59.663 24.408-24.407 51.12-37.269 59.663-28.726 8.542 8.543-4.319 35.255-28.727 59.662z" />
            </g>
          </svg>
        </div>
      </div>

      <div class="content-frame">
        <div class="glass-card full-width-card">
          <span class="header-name">SIGNALSHOP MENU</span>
          <div class="table-container">
            <table class="table cyber-table">
              <thead>
                <tr>
                  <th>T/r</th>
                  <th>Product Name</th>
                  <th>Type</th>
                  <th>Memory/Size</th>
                  <th>Price</th>
                  <th>Left Count</th>
                  <th>Description</th> <!-- Yangi ustun -->
                  <th>Status</th>
                </tr>
              </thead>
              <tbody style="background: #131727">
                <% products.map(function(value, key) { %>
                  <tr>
                    <td><%= key + 1 %></td>
                    <td><%= value.productName %></td>
                    <td><%= value.productCollection %></td>
                    <td><%= value.productCollection === "SMARTPHONE" ? value.productmemory : value.productSize %></td>
                    <td class="price-tag"><%= value.productPrice %>$</td>
                    <td><%= value.productLeftCount %> pc</td>
                    
                    <!-- PRODUCT DESCRIPTION MANTIQI -->
                    <td class="desc-cell" onclick="toggleDesc(this)" 
                        data-full="<%= value.productDesc %>" 
                        data-short="<%= value.productDesc.length > 10 ? value.productDesc.substring(0, 10) + '...' : value.productDesc %>">
                      <div class="desc-wrapper">
                        <%= value.productDesc.length > 10 ? value.productDesc.substring(0, 10) + '...' : value.productDesc %>
                      </div>
                    </td>

                    <td>
                      <select class="spec-select new-product-status" id="<%= value._id %>">
                        <option value="PAUSE" <%= value.productStatus === "PAUSE" ? "selected" : "" %>>PAUSE</option>
                        <option value="PROCESS" <%= value.productStatus === "PROCESS" ? "selected" : "" %>>PROCESS</option>
                        <option value="DELETE" <%= value.productStatus === "DELETE" ? "selected" : "" %>>DELETE</option>
                      </select>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <div class="footer-btn">
            <button class="neon-btn blue" id="process-btn">New Product <i class="fas fa-plus"></i></button>
          </div>
        </div>

        <form onsubmit="return validateForm()" action="/admin/product/create" method="POST"
            class="glass-card full-width-card dish-container" enctype="multipart/form-data" style="display: none;">
          <span class="header-name">NEW PRODUCT DETAIL</span>
          <div class="input-grid">
            <div class="input-group">
              <label>Product Name</label>
              <input type="text" name="productName" class="cyber-input product-name" placeholder="Name" />
            </div>
            <div class="input-group">
              <label>Price</label>
              <input type="number" name="productPrice" class="cyber-input product-price" placeholder="Price" />
            </div>
            <div class="input-group">
              <label>Left Counts</label>
              <input type="number" name="productLeftCount" class="cyber-input product-left-count" placeholder="Counts" />
            </div>
            <div class="input-group">
              <label>Condition</label>
              <select class="cyber-input product-condission" name="productCondission">
                <option value="NEW" selected>NEW</option>
                <option value="OLD">OLD</option>
              </select>
            </div>
            <div class="input-group">
              <label>Product Type</label>
              <select class="cyber-input product-collection" name="productCollection">
                <option value="ACCESORY" selected>ACCESORY</option>
                <option value="SMARTPHONE">SMARTPHONE</option>
                <option value="LAPTOP">LAPTOP</option>
                <option value="MONITORS">MONITORS</option>
                <option value="CASES">CASES</option>
                <option value="OTHER">Other</option>
              </select>
            </div>
            <div class="input-group" id="product-memory" style="display: none">
              <label>Memory</label>
              <select class="cyber-input product-memory" name="productmemory">
                <option value="128GB">128GB</option>
                <option value="256GB" selected>256GB</option>
                <option value="512GB">512GB</option>
                <option value="1TB">1TB</option>
              </select>
            </div>
          </div>
          <div class="input-group full">
            <label>Description</label>
            <textarea name="productDesc" class="cyber-textarea product-desc" placeholder="Enter product details..."></textarea>
          </div>
          <input name="productStatus" value="PAUSE" class="product-status" hidden />
          <input name="restaurantIid" class="restaurant-id" hidden />
          <div class="upload-section">
            <label>Product Images</label>
            <div class="media-row">
              <% for(let i=1; i<=5; i++) { %>
                <div class="upload-box">
                  <img src="/img/upload.svg" id="image-section-<%= i %>" class="preview-img" />
                  <input type="file" name="productImages" class="image-input image-<%= i===1?'one':i===2?'two':i===3?'three':i===4?'four':'five' %>" 
                         onchange="previewFileHandler(this, <%= i %>)" <%= i===1?'required':'' %> />
                  <div class="box-overlay"><i class="fas fa-plus"></i></div>
                </div>
              <% } %>
            </div>
          </div>
          <div class="form-actions">
            <button type="button" class="neon-btn red" id="cancel-btn">Cancel</button>
            <button type="submit" class="neon-btn purple" id="create-btn">Create Product</button>
          </div>
        </form>
      </div>
    </div>
  </div>
  <script type="text/javascript" src="/js/products.js"></script>
</body>
<%- include('includes/footer') %>